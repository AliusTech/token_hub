# ===== TokenHub 环境变量示例 =====
# 复制为 .env 后修改

# ----- 远程管理接入 (tun) -----
# 接入服务地址（默认使用 Alius 托管接入服务）
TUN_SERVER=frp.alius.tech
TUN_PORT=7000
# 随机服务 ID，决定子域名 <SUBDOMAIN>.tun.alius.tech
TUN_SUBDOMAIN=change-me
# frps 开启 token 鉴权时填写（留空则不启用）
TUN_TOKEN=

# ----- TokenHub 服务 -----
# 服务器密钥：用于 API Token 哈希、session token 签名等，部署时务必改为强随机值
SERVER_SECRET=change-me-please
# SQLite 数据库路径（容器内）
DATABASE_URL=sqlite:///data/tokenhub.db
# Redis 连接（独立服务）
REDIS_URL=redis://redis:6379
# 双端口监听
CHAT_LISTEN=0.0.0.0:8080
ADMIN_LISTEN=0.0.0.0:8081
